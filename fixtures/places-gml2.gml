<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written for agrafe: GML 2, as an OGR export writes it, around
     Fourvière in Lyon, in degrees longitude first. -->
<ogr:FeatureCollection
    xmlns:ogr="http://ogr.maptools.org/"
    xmlns:gml="http://www.opengis.net/gml">
  <gml:boundedBy>
    <gml:Box srsName="http://www.opengis.net/gml/srs/epsg.xml#4326">
      <gml:coord><gml:X>4.80</gml:X><gml:Y>45.75</gml:Y></gml:coord>
      <gml:coord><gml:X>4.84</gml:X><gml:Y>45.77</gml:Y></gml:coord>
    </gml:Box>
  </gml:boundedBy>
  <gml:featureMember>
    <ogr:places fid="places.0">
      <ogr:geometryProperty>
        <gml:Polygon srsName="http://www.opengis.net/gml/srs/epsg.xml#4326">
          <gml:outerBoundaryIs>
            <gml:LinearRing>
              <gml:coordinates>4.818,45.760 4.826,45.760 4.826,45.766 4.818,45.766 4.818,45.760</gml:coordinates>
            </gml:LinearRing>
          </gml:outerBoundaryIs>
          <gml:innerBoundaryIs>
            <gml:LinearRing>
              <gml:coordinates>4.821,45.762 4.821,45.764 4.823,45.764 4.823,45.762 4.821,45.762</gml:coordinates>
            </gml:LinearRing>
          </gml:innerBoundaryIs>
        </gml:Polygon>
      </ogr:geometryProperty>
      <ogr:name>Basilique</ogr:name>
    </ogr:places>
  </gml:featureMember>
  <gml:featureMember>
    <ogr:places fid="places.1">
      <ogr:geometryProperty>
        <gml:MultiLineString srsName="http://www.opengis.net/gml/srs/epsg.xml#4326">
          <gml:lineStringMember>
            <gml:LineString>
              <gml:coordinates decimal="," cs=";" ts=" ">4,805;45,752 4,812;45,756 4,818;45,760</gml:coordinates>
            </gml:LineString>
          </gml:lineStringMember>
        </gml:MultiLineString>
      </ogr:geometryProperty>
      <ogr:name>Montée</ogr:name>
    </ogr:places>
  </gml:featureMember>
  <gml:featureMember>
    <ogr:places fid="places.2">
      <ogr:geometryProperty>
        <gml:Point srsName="http://www.opengis.net/gml/srs/epsg.xml#4326">
          <gml:coord><gml:X>4.8357</gml:X><gml:Y>45.764</gml:Y></gml:coord>
        </gml:Point>
      </ogr:geometryProperty>
      <ogr:name>Fourvière</ogr:name>
    </ogr:places>
  </gml:featureMember>
</ogr:FeatureCollection>
