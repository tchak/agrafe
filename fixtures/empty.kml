    <name>Hand-written for agrafe: nothing to draw</name>
    <Style id="s">
      <LineStyle>
        <color>ff0000ff</color>
      </LineStyle>
    </Style>
    <GroundOverlay>
      <name>Plan</name>
      <Icon>
        <href>files/plan.png</href>
